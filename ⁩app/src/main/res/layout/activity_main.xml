<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_purple_gradient"
    android:padding="20dp">

    <!-- ==================== TAB 1: HOME (MENU UTAMA) ==================== -->
    <LinearLayout
        android:id="@+id/layoutTabHome"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavContainer"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <!-- Top Bar dengan Logo Aplikasi & Tombol Buy Key -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="Logo"
                android:src="@drawable/ic_app_logo" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:letterSpacing="0.12"
                android:text="DEFFENDER VIP"
                android:textColor="#E9D5FF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnHomeBuyKey"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:background="@drawable/bg_buy_key_pill"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp"
                android:text="BUY KEY"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvConnectionTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="sans-serif-light"
            android:text="00:00:00"
            android:textColor="#FFFFFF"
            android:textSize="42sp" />

        <TextView
            android:id="@+id/tvConnectionStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_badge_disconnected"
            android:letterSpacing="0.1"
            android:paddingHorizontal="20dp"
            android:paddingVertical="6dp"
            android:text="DISCONNECTED"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Power Orb Center -->
        <FrameLayout
            android:id="@+id/btnPowerConnect"
            android:layout_width="172dp"
            android:layout_height="172dp"
            android:background="@drawable/bg_power_orb_idle"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="Power"
                android:src="@drawable/ic_power" />
        </FrameLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Kartu Ganti 3 Host DNS di Menu Utama -->
        <LinearLayout
            android:id="@+id/cardCurrentDnsHome"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_marginBottom="14dp"
            android:background="@drawable/bg_glass_card"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tvSelectedDnsBadge"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_purple_circle_btn"
                android:gravity="center"
                android:text="CF"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSelectedDnsName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cloudflare Private DNS"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSelectedDnsHost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Host: one.one.one.one  •  14 ms"
                    android:textColor="#C4B5FD"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnQuickSwitchDns"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_purple_circle_btn"
                android:contentDescription="Ganti Host DNS"
                android:src="@drawable/ic_arrow_right" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== TAB 2: PILIH 3 HOST DNS ==================== -->
    <LinearLayout
        android:id="@+id/layoutTabDns"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavContainer"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.16"
            android:text="PRIVATE DNS HOSTS"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Pilih 3 Server Hostname DNS"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- DNS 1 -->
        <LinearLayout
            android:id="@+id/cardDnsOption1"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_white_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_purple_circle_btn"
                android:gravity="center"
                android:text="CF"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDns1Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cloudflare Private DNS"
                    android:textColor="#1E1035"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDns1Host"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="one.one.one.one"
                    android:textColor="#7C3AED"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDns1Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ultra Cepat &amp; Encrypted DNS"
                    android:textColor="#6B5B8C"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:id="@+id/radioDns1"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_radio_selected" />
        </LinearLayout>

        <!-- DNS 2 -->
        <LinearLayout
            android:id="@+id/cardDnsOption2"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_white_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_purple_circle_btn"
                android:gravity="center"
                android:text="AG"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDns2Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AdGuard Private DNS"
                    android:textColor="#1E1035"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDns2Host"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="dns.adguard-dns.com"
                    android:textColor="#7C3AED"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDns2Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Blokir Iklan, Tracker &amp; Malware"
                    android:textColor="#6B5B8C"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:id="@+id/radioDns2"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_radio_unselected" />
        </LinearLayout>

        <!-- DNS 3 -->
        <LinearLayout
            android:id="@+id/cardDnsOption3"
            android:layout_width="match_parent"
            android:layout_height="84dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_white_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_purple_circle_btn"
                android:gravity="center"
                android:text="Q9"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDns3Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quad9 Security DNS"
                    android:textColor="#1E1035"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDns3Host"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="dns.quad9.net"
                    android:textColor="#7C3AED"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDns3Sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Proteksi Phishing &amp; Ancaman Siber"
                    android:textColor="#6B5B8C"
                    android:textSize="11sp" />
            </LinearLayout>

            <View
                android:id="@+id/radioDns3"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:background="@drawable/bg_radio_unselected" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== TAB 3: STATISTICS ==================== -->
    <LinearLayout
        android:id="@+id/layoutTabStats"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavContainer"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.16"
            android:text="STATISTICS"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Download"
                    android:textColor="#A7F3D0"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="75 mb/s"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_card"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Upload"
                    android:textColor="#DDD6FE"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="50 mb/s"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatPing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Ping 14 ms"
            android:textColor="#E9D5FF"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Connection Details"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Active Private DNS Hostname"
                android:textColor="#C4B5FD"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/tvStatDnsName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Cloudflare Private DNS"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatDnsHost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="one.one.one.one"
                android:textColor="#A7F3D0"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== TAB 4: BUY KEY & VIP LICENSE ==================== -->
    <LinearLayout
        android:id="@+id/layoutTabAccount"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/bottomNavContainer"
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:letterSpacing="0.16"
            android:text="BUY KEY &amp; VIP LICENSE"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <!-- Kartu Menu Buy Key -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pembelian API Key VIP"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCurrentBuyKeyUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="https://deffender.vip/buy-key"
                android:textColor="#C4B5FD"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnOpenBuyKeyWeb"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#8B5CF6"
                android:text="BUKA WEBSITE BUY KEY"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnEditBuyKeyUrl"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Ubah / Konfigurasi Link Website"
                android:textColor="#DDD6FE"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Kartu Info Lisensi Supabase -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_glass_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pemilik Token"
                android:textColor="#C4B5FD"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvAccountOwner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIP Member"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="API Token Aktif"
                android:textColor="#C4B5FD"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvAccountToken"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#A7F3D0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Masa Berlaku"
                android:textColor="#C4B5FD"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tvAccountExpiry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="-"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnLogoutToken"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_badge_disconnected"
                android:gravity="center"
                android:text="GANTI / KELUAR TOKEN"
                android:textColor="#FCA5A5"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- ==================== FLOATING PILL BOTTOM NAVIGATION ==================== -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_bottom_nav_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/navItemHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_nav_active_pill"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Home"
                android:textColor="#1E1035"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navItemDns"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DNS (3)"
                android:textColor="#1E1035"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navItemStats"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stats"
                android:textColor="#1E1035"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navItemAccount"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.15"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Buy Key"
                android:textColor="#1E1035"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
